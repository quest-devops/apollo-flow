APP_DOMAIN=localhost:8080
APP_RELEASE=apollo

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443

WEB_URL=http://localhost:8080
DEBUG=0
CORS_ALLOWED_ORIGINS=http://localhost:8080
API_BASE_URL=http://api:8000

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data

REDIS_HOST=plane-redis
REDIS_PORT=6379

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80

SECRET_KEY=60gp0byfz2dvffa45cxl20p1scy9xbpf6d8c5y0geejgkyp1b5

USE_MINIO=1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

GUNICORN_WORKERS=1
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute
LIVE_SERVER_SECRET_KEY=apollo-lab-live-secret-2026
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# E-mail — remetente padrão (nome + endereço). Semeia a config de instância no 1o boot.
# Host/porta/usuário/senha SMTP são configurados na UI do admin (/god-mode > Email).
EMAIL_FROM=ApolloFlow <no-reply@apollosolution.com.br>

# Cadastro público desativado: só entra quem recebeu convite de um admin.
# Semeia a config de instância no registro; reversível no god-mode > Authentication.
ENABLE_SIGNUP=0
